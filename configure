#!/usr/bin/env sh
set -eu

local_yices=0
smt2_static=0

usage() {
  cat <<'EOF'
Usage: ./configure [options]

Configure default Makefile options by writing config.mk.

Options:
  --help                         Show this help
  --local-yices                  Force vendored/local Yices by default
  --static                       Link SMT2 executables statically

Examples:
  ./configure --local-yices
  ./configure --local-yices --static
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --help|-h)
      usage
      exit 0
      ;;
    --local-yices)
      local_yices=1
      shift
      ;;
    --static)
      smt2_static=1
      shift
      ;;
    *)
      echo "unknown option: $1" >&2
      echo "run ./configure --help for usage" >&2
      exit 2
      ;;
  esac
done

cat > config.mk <<EOF
# Generated by ./configure. Do not edit by hand.
YICES2_FORCE_LOCAL := $local_yices
YICES2_SMT2_STATIC := $smt2_static
EOF

cat <<EOF
Configured Make defaults in config.mk:
  YICES2_FORCE_LOCAL=$local_yices
  YICES2_SMT2_STATIC=$smt2_static

Run 'make' to build.
EOF
