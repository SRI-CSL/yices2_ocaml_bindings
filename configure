#!/usr/bin/env sh
set -eu

local_yices=0
mcsat=1
delegates=1
without_delegates=""

usage() {
  cat <<'EOF'
Usage: ./configure [options]

Configure default Makefile options by writing config.mk.

Options:
  --help                         Show this help
  --local-yices                  Force vendored/local Yices by default
  --mcsat                        Build/require MCSAT support (default)
  --no-mcsat                     Build/use Yices without MCSAT/CUDD
  --with-delegates               Enable delegate SAT solvers (default)
  --no-delegates                 Disable all delegate SAT solvers
  --without-delegate NAME        Disable one delegate; repeatable
  --without-delegate=NAME        Same as above
  --without-delegates LIST       Disable delegates in LIST
  --without-delegates=LIST       Same as above

Delegate names: cadical, cryptominisat, kissat.

Examples:
  ./configure --local-yices
  ./configure --local-yices --no-mcsat
  ./configure --local-yices --without-delegate cadical --without-delegate kissat
  ./configure --local-yices --without-delegates=cadical,kissat
EOF
}

append_without_delegate() {
  name="$1"
  case "$name" in
    cadical|cryptominisat|kissat) ;;
    "")
      echo "empty delegate name in --without-delegate" >&2
      exit 2
      ;;
    *)
      echo "unknown delegate '$name' (expected cadical, cryptominisat, or kissat)" >&2
      exit 2
      ;;
  esac
  without_delegates="${without_delegates}${without_delegates:+ }$name"
}

append_without_delegates() {
  old_ifs="$IFS"
  IFS=', '
  for name in $1; do
    append_without_delegate "$name"
  done
  IFS="$old_ifs"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --help|-h)
      usage
      exit 0
      ;;
    --local-yices)
      local_yices=1
      shift
      ;;
    --mcsat)
      mcsat=1
      shift
      ;;
    --no-mcsat)
      mcsat=0
      shift
      ;;
    --with-delegates)
      delegates=1
      shift
      ;;
    --no-delegates|--without-all-delegates)
      delegates=0
      shift
      ;;
    --without-delegate=*)
      append_without_delegate "${1#*=}"
      shift
      ;;
    --without-delegate)
      if [ "$#" -lt 2 ]; then
        echo "--without-delegate requires an argument" >&2
        exit 2
      fi
      append_without_delegate "$2"
      shift 2
      ;;
    --without-delegates=*)
      append_without_delegates "${1#*=}"
      shift
      ;;
    --without-delegates)
      if [ "$#" -lt 2 ]; then
        echo "--without-delegates requires an argument" >&2
        exit 2
      fi
      append_without_delegates "$2"
      shift 2
      ;;
    *)
      echo "unknown option: $1" >&2
      echo "run ./configure --help for usage" >&2
      exit 2
      ;;
  esac
done

cat > config.mk <<EOF
# Generated by ./configure. Do not edit by hand.
YICES2_FORCE_LOCAL := $local_yices
YICES2_ENABLE_MCSAT := $mcsat
YICES2_ENABLE_DELEGATES := $delegates
YICES2_WITHOUT_DELEGATES := $without_delegates
EOF

cat <<EOF
Configured Make defaults in config.mk:
  YICES2_FORCE_LOCAL=$local_yices
  YICES2_ENABLE_MCSAT=$mcsat
  YICES2_ENABLE_DELEGATES=$delegates
  YICES2_WITHOUT_DELEGATES=$without_delegates

Run 'make' to build.
EOF
