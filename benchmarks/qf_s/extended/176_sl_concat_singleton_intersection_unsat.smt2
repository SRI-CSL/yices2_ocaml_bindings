; EXPECT: unsat
(set-logic QF_SLIA)
(declare-const x String)
(declare-const y String)
(declare-const z String)
(assert (= z (str.++ x y)))
(assert (str.in_re z (re.inter (str.to_re "ab") (re.++ (str.to_re "a") re.allchar))))
(assert (= (str.len x) 1))
(assert (= (str.len y) 1))
(assert (not (= y "b")))
(check-sat)
